# ---------- Server ----------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ---------- PostgreSQL ----------
DB_USER=postgres
DB_HOST=localhost
DB_NAME=helporbit_db
DB_PASSWORD=changeme
DB_PORT=5432
DB_POOL_MAX=10

# ---------- JWT ----------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---------- Redis (optional during early dev) ----------
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ---------- Elasticsearch (optional during early dev) ----------
ELASTIC_URL=http://localhost:9200
ELASTIC_INDEX=helporbit-logs
ELASTIC_ENABLED=false
LOG_LEVEL=info
